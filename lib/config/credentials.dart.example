/// Telegram application credentials template.
///
/// Obtain your `api_id` and `api_hash` from https://my.telegram.org (under 'API development tools').
/// Copy or rename this file to `lib/config/credentials.dart` and fill in your values.
class TgCredentials {
  TgCredentials._();

  static const int apiId = 0; // Replace with your Telegram API ID
  static const String apiHash = 'YOUR_TELEGRAM_API_HASH'; // Replace with your Telegram API Hash
  static const String appName = 'TellMeMore TG';
  static const String appVersion = '1.0.0';
}
